# Multi-account configuration (JSON array)
# Each account needs a name and apiKey. baseUrl is optional.
SENDGRID_ACCOUNTS='[{"name":"production","apiKey":"SG.xxx"},{"name":"staging","apiKey":"SG.yyy"}]'

# Single account fallback (used when SENDGRID_ACCOUNTS is not set)
# SENDGRID_API_KEY=SG.your-api-key-here
