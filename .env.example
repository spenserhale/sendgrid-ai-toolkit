# Multi-account configuration (JSON array). Preferred.
# Each account needs a name and apiKey. baseUrl and timeoutMs are optional per account.
SENDGRID_ACCOUNTS='[{"name":"brand-a","apiKey":"SG.xxx"},{"name":"brand-b","apiKey":"SG.yyy"}]'

# Single account fallback (used when SENDGRID_ACCOUNTS is not set; account is named "default")
# SENDGRID_API_KEY=SG.your-api-key-here

# Optional: API base URL (default https://api.sendgrid.com)
# SENDGRID_BASE_URL=https://api.sendgrid.com

# Optional: per-request timeout in milliseconds (default 60000).
# Email Activity queries are slow; keep this at or above 30000.
# SENDGRID_TIMEOUT_MS=60000

# Optional: default output format. CLI: text | json | toon (flags override). MCP: json | toon.
# SENDGRID_OUTPUT=text
